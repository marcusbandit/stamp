<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Photo scan: read the GPS position saved in each photo. Nothing leaves the device. -->
    <uses-permission android:name="android.permission.READ_MEDIA_IMAGES" />
    <uses-permission android:name="android.permission.READ_MEDIA_VIDEO" />
    <uses-permission android:name="android.permission.READ_MEDIA_VISUAL_USER_SELECTED" />
    <uses-permission
        android:name="android.permission.READ_EXTERNAL_STORAGE"
        android:maxSdkVersion="32" />
    <uses-permission android:name="android.permission.ACCESS_MEDIA_LOCATION" />

    <!-- Where you are now, roughly: enough to name the country you are in and open the map
         there. Read from the phone's own location service; nothing leaves the device. -->
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <!-- The hourly look for the heat map runs while Stamp is closed, which needs Allow all the
         time. Only ever asked for when the user switches the hourly look on. -->
    <uses-permission android:name="android.permission.ACCESS_BACKGROUND_LOCATION" />

    <!-- Only to fetch the rail and road lines of a country a trip goes through, from the public
         data repository, and to ask GitHub whether a newer Stamp is out. The map itself is
         bundled, and nothing about the user is sent. -->
    <uses-permission android:name="android.permission.INTERNET" />

    <!-- Installs a newer Stamp from its GitHub release when the user taps Update. The Play
         bundle leaves this out (src/play/AndroidManifest.xml): Play updates that copy. -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />
    <!-- Once Stamp installed itself, later updates go in without Android asking again. -->
    <uses-permission android:name="android.permission.UPDATE_PACKAGES_WITHOUT_USER_ACTION" />

    <!-- MapLibre asks for these, but Stamp draws a bundled map with no tiles and needs no exact
         position. -->
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" tools:node="remove" />
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" tools:node="remove" />

    <application
        android:name=".StampApp"
        android:largeHeap="true"
        android:enableOnBackInvokedCallback="true"
        android:allowBackup="true"
        android:fullBackupContent="@xml/backup_rules"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.Stamp">
        <!-- Lets the shell take a heap dump of the release build, to find what holds memory. -->
        <profileable android:shell="true" />
        <!-- configChanges keeps the activity alive across fold, unfold and rotate.
             Compose recomposes from the new window size instead of a full restart. -->
        <!-- singleTop: a shortcut, a shared photo or a place link while Stamp is already in
             front goes to the activity that shows (onNewIntent) instead of a second copy. -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|density|keyboardHidden|uiMode">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- A photo shared into Stamp: its location is read on the phone to open the
                 country it was taken in. Nothing is uploaded or kept. -->
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="image/*" />
            </intent-filter>
            <!-- A place link, geo:lat,lon, opens the map there with the country's card. -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="geo" />
            </intent-filter>
            <meta-data android:name="android.app.shortcuts" android:resource="@xml/shortcuts" />
        </activity>

        <!-- WorkManager starts on demand, from StampApp, instead of on the main thread at every
             launch: only the hourly look uses it. -->
        <provider
            android:name="androidx.startup.InitializationProvider"
            android:authorities="${applicationId}.androidx-startup"
            android:exported="false"
            tools:node="merge">
            <meta-data
                android:name="androidx.work.WorkManagerInitializer"
                android:value="androidx.startup"
                tools:node="remove" />
        </provider>
        <!-- Hears back from Android's installer while an update goes in. -->
        <receiver android:name=".data.UpdateReceiver" android:exported="false" />
    </application>

</manifest>
